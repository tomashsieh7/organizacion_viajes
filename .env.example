# Copiar a apps/api/.env y ajustar si hace falta.

# Puerto del backend
PORT=3000
# Entorno: development, test o production
NODE_ENV=development
# Origen del frontend; se usa para CORS y la verificación de Origin desde F2
ORIGEN_WEB=http://localhost:5173

# Bases de datos (se usan desde F1). Coinciden con docker-compose.yml.
DATABASE_URL=postgresql://viajes:viajes@localhost:5432/viajes
DATABASE_URL_TEST=postgresql://viajes:viajes@localhost:5433/viajes_test
